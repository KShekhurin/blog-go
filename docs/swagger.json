{
    "swagger": "2.0",
    "info": {
        "description": "This is the example of a twitter-like blog written on go",
        "title": "Blog API",
        "contact": {},
        "version": "1.0.0"
    },
    "host": "localhost:9090",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "An API route to login an user, on success returns access/refresh jwt pair\nEther login or email is required",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login with existing user",
                "parameters": [
                    {
                        "description": "Login payload",
                        "name": "user_data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/webModels.UserLoginInfo"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webModels.TokenPair"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Remove refresh token from allow list",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log out",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Exchange a valid refresh token for a new token pair",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh access/refresh pair",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webModels.TokenPair"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "An API route to register a new user, on success returns access/refresh jwt pair",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration payload",
                        "name": "user_data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/webModels.UserRegisterInfo"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webModels.TokenPair"
                        }
                    }
                }
            }
        },
        "/post": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "An API route to send a post, requires an access token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "posts"
                ],
                "summary": "Send a post from the user",
                "parameters": [
                    {
                        "description": "Post payload",
                        "name": "post_data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/webModels.CreatePostRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webModels.Post"
                        }
                    }
                }
            }
        },
        "/user/{author_id}/subscriptions": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "An API route to subscribe user to the author with the specified ID\nUser's ID is provided in JWT token",
                "tags": [
                    "user"
                ],
                "summary": "Subscribe the user to the author",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Author ID",
                        "name": "author_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "An API route to unsubscribe user with the author with the specified ID\nUser's ID is provided in JWT token",
                "tags": [
                    "user"
                ],
                "summary": "Unsubscribe the user from the author",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Author ID",
                        "name": "author_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/user/{user_id}/posts": {
            "get": {
                "description": "An API route to get the user's post, on consecutive requests pass the cursor",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "posts"
                ],
                "summary": "Get posts from the user",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User ID",
                        "name": "user_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Pagination cursor",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Post cnt limit",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webModels.PostPaginationResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "webModels.AttachedMedia": {
            "type": "object",
            "properties": {
                "display_order": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "mime_type": {
                    "type": "string"
                },
                "post_id": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "webModels.CreateAttachedMedia": {
            "type": "object",
            "required": [
                "display_order",
                "mime_type",
                "type",
                "url"
            ],
            "properties": {
                "display_order": {
                    "type": "integer",
                    "minimum": 0
                },
                "mime_type": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "webModels.CreatePostRequest": {
            "type": "object",
            "required": [
                "content"
            ],
            "properties": {
                "attached": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/webModels.CreateAttachedMedia"
                    }
                },
                "content": {
                    "type": "string"
                },
                "reply_to": {
                    "type": "string"
                }
            }
        },
        "webModels.Post": {
            "type": "object",
            "properties": {
                "attached": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/webModels.AttachedMedia"
                    }
                },
                "author_id": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "reply_to": {
                    "type": "string"
                }
            }
        },
        "webModels.PostPaginationResponse": {
            "type": "object",
            "properties": {
                "cursor": {
                    "type": "string"
                },
                "posts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/webModels.Post"
                    }
                }
            }
        },
        "webModels.TokenPair": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "webModels.UserLoginInfo": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "webModels.UserRegisterInfo": {
            "type": "object",
            "required": [
                "email",
                "login",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "Type \"Bearer\" followed by a space and JWT token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}