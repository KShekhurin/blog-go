# Required
DATABASE_URL=postgres://root:password@localhost:5432/blog_db
REDIS_URL=redis://default:password@localhost:6379/0?protocol=2
# Ed25519 private key in PKCS8 PEM format: openssl genpkey -algorithm ed25519
# Dev-only ключ, замените на свой в продакшне
JWT_SECRET="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIMQZ9a3SNmoJuuGTVwVPquqAj8IYXF79bQ3mSjq1ZJEN
-----END PRIVATE KEY-----"

# Optional
SERVER_PORT=8080
SERVER_DEV_ADDRESS=localhost
IS_RELEASE=0
OTLP_GRPC_ADDRESS=localhost:14317
UPTRACE_DSN=
ARGON2_MEMORY=65536

# Docker compose only (хосты внутри compose-сети подставляются автоматически)
WEB_PORT=9090
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=blog_db
REDIS_PASSWORD=password
